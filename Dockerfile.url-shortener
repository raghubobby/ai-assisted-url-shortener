FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY url-shortener/pom.xml url-shortener/pom.xml
COPY url-shortener/src url-shortener/src
RUN mvn -B -pl url-shortener -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/url-shortener/target/url-shortener-1.0.0.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java","-jar","/app/app.jar"]
