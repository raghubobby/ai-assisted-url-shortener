# PostgreSQL/local production-like profile
URL_DB_URL=jdbc:postgresql://localhost:5432/aiassist?currentSchema=url_shortener
URL_DB_USER=aiassist
URL_DB_PASSWORD=aiassist

# Optional Redis cache
REDIS_HOST=localhost
REDIS_PORT=6379
SHORT_URL_CACHE_ENABLED=false

# Public short-link base URL
SHORT_URL_BASE_URL=http://localhost:8082/r

# Instance identifier (visible in X-App-Instance)
APP_INSTANCE_ID=local
